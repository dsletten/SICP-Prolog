tolerance(0.00001).
close_enough_fixed_point(X0, X1) :-
    tolerance(T),
    abs(X0 - X1) < T.
fixed_point(F, Guess, V) :-
    call(F, Guess, Next),
    fixed_point_next(F, Guess, Next, V).
fixed_point_next(_, Guess, Next, Next) :-
    close_enough_fixed_point(Guess, Next), !.
fixed_point_next(F, _, Next, V) :-
    fixed_point(F, Next, V).

