accumulate(_, Null, _, A, _, B, Null) :- A > B, !.
accumulate(Combiner, Null, Term, A, Next, B, V) :-
    call(Next, A, A1),
    call(Term, A, Y),
    accumulate(Combiner, Null, Term, A1, Next, B, V1),
    call(Combiner, Y, V1, V).

accumulate_sum(Term, A, Next, B, S) :-
    accumulate([X, Y, Z] >> (Z is X + Y), 0, Term, A, Next, B, S).

accumulate_product(Term, A, Next, B, P) :-
    accumulate([X, Y, Z] >> (Z is X * Y), 1, Term, A, Next, B, P).

