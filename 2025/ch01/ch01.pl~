filtered_accumulate(_, _, Null, _, A, _, B, Null) :- A > B, !.
filtered_accumulate(P, Combiner, Null, Term, A, Next, B, V) :-
    call(P, A),
    !,
    call(Next, A, A1),
    call(Term, A, Y),
    filtered_accumulate(P, Combiner, Null, Term, A1, Next, B, V1),
    call(Combiner, Y, V1, V).
filtered_accumulate(P, Combiner, Null, Term, A, Next, B, V) :-
    call(Next, A, A1),
    filtered_accumulate(P, Combiner, Null, Term, A1, Next, B, V).

filtered_accumulate_factorial(N, P) :-
    filtered_accumulate([_] >> (true), [X, Y, Z] >> (Z is X * Y), 1, identity, 1, [X, Y] >> (Y is X + 1), N, P).

filtered_accumulate_tr(P, Combiner, Null, Term, A, Next, B, V) :-
    filtered_accumulate_(P, Combiner, Term, A, Next, B, Null, V).
filtered_accumulate_(_, _, _, A, _, B, V, V) :- A > B, !.
filtered_accumulate_(P, Combiner, Term, A, Next, B, Acc, V) :-
    call(P, A),
    !,
    call(Term, A, Y),
    call(Next, A, A1),
    call(Combiner, Acc, Y, Acc1),
    filtered_accumulate_(P, Combiner, Term, A1, Next, B, Acc1, V).

smallest_divisor(N, D) :-
    find_divisor(N, 2, D1),
    !,
    D = D1.

find_divisor(N, T, N) :-
    square(T, T2),
    T2 > N,
    !.
find_divisor(N, T, T) :-
    divides(T, N),
    !.
find_divisor(N, T, D) :-
    T1 is T + 1,
    find_divisor(N, T1, D).

divides(D, N) :-
    N rem D =:= 0.

is_prime(1) :- !, fail.
is_prime(N) :-
    smallest_divisor(N, N).

sum_prime_squares(A, B, S) :-
    filtered_accumulate([N] >> (is_prime(N)), [X, Y, Z] >> (Z is X + Y), 0, square, A, [X, Y] >> (Y is X + 1), B, S).

