close_enough_search(X, Y) :- abs(X - Y) < 0.001.
search(_, A, B, V) :-
    close_enough_search(A, B), !,
    average(A, B, V).
search(F, A, B, V) :-
    average(A, B, M),
    call(F, M, Y),
    choose_search(F, A, B, M, Y, V).

choose_search(F, A, _, M, Y, V) :-
    Y > 0,
    !,
    search(F, A, M, V).
choose_search(F, _, B, M, Y, V) :-
    Y < 0,
    !,
    search(F, M, B, V).
choose_search(_, _, _, M, _, M).

half_interval_method(F, A, B, V) :-
