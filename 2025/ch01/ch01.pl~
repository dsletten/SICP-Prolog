    call(F, B, Vb),
    choose_half_interval(F, A, B, Va, Vb, V).

choose_half_interval(F, A, B, Va, Vb, V) :-
    Va < 0,
    Vb > 0,
    !,
    search(F, A, B, V).
choose_half_interval(F, A, B, Va, Vb, V) :-
    Vb < 0,
    Va > 0,
    !,
    search(F, B, A, V).

