accumulate_(_, _, A, _, B, V, V) :- A > B, !.
accumulate_(Combiner, Term, A, Next, B, Acc, V) :-
    call(Next, A, A1),
    call(Term, A, Y),
    call(Combiner, Acc, Y, Acc1),
    accumulate_(Combiner, Term, A1, Next, B, Acc1, V).

accumulate_sum_tr(Term, A, Next, B, S) :-
    accumulate_tr([X, Y, Z] >> (Z is X + Y), 0, Term, A, Next, B, S).

accumulate_product_tr(Term, A, Next, B, P) :-
    accumulate_tr([X, Y, Z] >> (Z is X * Y), 1, Term, A, Next, B, P).

accumulate_sum_integers(A, B, S) :-
    accumulate_sum(identity, A, [X, Y] >> (Y is X + 1), B, S).

%%    AKA factorial
accumulate_product_integers(A, B, P) :-
    accumulate_product(identity, A, [X, Y] >> (Y is X + 1), B, P).

