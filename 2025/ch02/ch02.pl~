horizontal(S) :-
    destructure_segment(S, _, _, Y0, _, _, Y1),
    Y0 =:= Y1.

vertical(S) :-
    destructure_segment(S, _, X0, _, _, X1, _),
    X0 =:= X1.

slope(S, 0) :- horizontal(S), !.
slope(S, infinity) :- vertical(S), !.
slope(S, M) :-
    destructure_segment(S, _, X0, Y0, _, X1, Y1),
    M is (Y1 - Y0) / (X1 - X0).

parallel(S1, S2) :- horizontal(S1), !, horizontal(S2).
parallel(S1, S2) :- vertical(S1), !, vertical(S2).
parallel(_, S2) :- vertical(S2), !, fail.
parallel(S1, S2) :-
    slope(S1, M1),
    slope(S2, M2),
    approximately_equal(M1, M2).

perpendicular(S1, S2) :- horizontal(S1), !, vertical(S2).
perpendicular(S1, S2) :- vertical(S1), !, horizontal(S2).
perpendicular(_, S2) :- vertical(S2), !, fail.
perpendicular(S1, S2) :-
    slope(S1, M1),
    slope(S2, M2),
    X is M1 * M2,
    approximately_equal(X, -1).

