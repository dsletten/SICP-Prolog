%% make_rat(N, D, rational(N1, D1)) :-
%%     G is gcd(N, D),
%%     N1 is N / G,
%%     D1 is D / G.
make_rat(N, D, R) :-
    D < 0,
    !,
    N1 is -N,
    D1 is -D,
    make_rat(N1, D1, R).
make_rat(N, D, rational(N1, D1)) :-
    G is gcd(N, D),
    N1 is N / G,
    D1 is D / G.
numer(rational(N, _), N).
denom(rational(_, D), D).

add_rat(rational(N0, D0), rational(N1, D1), Sum) :-
    N is N0 * D1 + N1 * D0,
    D is D0 * D1,
    make_rat(N, D, Sum).

sub_rat(rational(N0, D0), rational(N1, D1), Diff) :-
    N is N0 * D1 - N1 * D0,
    D is D0 * D1,
    make_rat(N, D, Diff).

mul_rat(rational(N0, D0), rational(N1, D1), Prod) :-
    N is N0 * N1,
    D is D0 * D1,
    make_rat(N, D, Prod).

div_rat(rational(N0, D0), rational(N1, D1), Quot) :-
    N is N0 * D1,
    D is D0 * N1,
    make_rat(N, D, Quot).

equal_rat(rational(N0, D0), rational(N1, D1)) :-
    N0 * D1 =:= N1 * D0.

